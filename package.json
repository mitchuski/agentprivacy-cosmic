{
  "name": "cosmic-spellbook",
  "version": "0.1.0",
  "description": "Transform satellite-sourced cosmic entropy into emoji spell strings through AI mage agents",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "cosmic-spellbook": "./dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "ts-node src/index.ts",
    "cli": "ts-node cli/index.ts",
    "spell": "ts-node cli/index.ts spell",
    "beacon": "ts-node cli/index.ts beacon",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "lint": "eslint src cli --ext .ts",
    "format": "prettier --write \"src/**/*.ts\" \"cli/**/*.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "cosmic",
    "entropy",
    "randomness",
    "spellbook",
    "emoji",
    "privacy",
    "blockchain",
    "ctrng",
    "spacecomputer",
    "orbitport"
  ],
  "author": "privacymage",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/[org]/cosmic-spellbook.git"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "commander": "^12.0.0",
    "dotenv": "^16.4.0",
    "chalk": "^5.3.0",
    "ora": "^8.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.3.0",
    "ts-node": "^10.9.0",
    "vitest": "^1.2.0",
    "@vitest/coverage-v8": "^1.2.0",
    "eslint": "^8.56.0",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "prettier": "^3.2.0"
  },
  "optionalDependencies": {
    "openai": "^4.28.0",
    "@anthropic-ai/sdk": "^0.17.0"
  }
}
